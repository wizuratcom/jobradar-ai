# Development-only PostgreSQL settings for Docker Compose. Do not use in production.
POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar
DATABASE_URL=postgresql+asyncpg://jobradar:jobradar@db:5432/jobradar
CANDIDATE_PROFILE_PATH=candidate.example.yaml
LLM_ENABLED=false
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
