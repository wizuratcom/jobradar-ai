# Development-only PostgreSQL settings for Docker Compose. Do not use in production.
POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar
DATABASE_URL=postgresql+asyncpg://jobradar:jobradar@db:5432/jobradar
CANDIDATE_PROFILE_PATH=candidate.example.yaml
JWT_SECRET=change-me-for-local-development-32b
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
LLM_ENABLED=false
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
AI_DEFAULT_GRADE=1
AI_GRADE1_MODEL=gpt-5.6-luna
AI_GRADE2_MODEL=gpt-5.6-luna
AI_GRADE3_MODEL=gpt-5.6-terra
AI_GRADE1_REASONING=low
AI_GRADE2_REASONING=medium
AI_GRADE3_REASONING=high
